#!/bin/sh

run_check() {
  tmpfile=$(mktemp)
  if ! "$@" > "$tmpfile" 2>&1; then
    echo "❌ $* failed:"
    cat "$tmpfile"
    rm -f "$tmpfile"
    exit 1
  fi
  rm -f "$tmpfile"
}

staged=$(git diff --cached --name-only)

changed() {
  printf '%s\n' "$staged" | grep -qE "$1"
}

if changed '^src/'; then
  run_check yarn test
  run_check yarn lint
  run_check yarn typecheck
  run_check yarn api-extractor
fi

if changed '^ios/'; then
  run_check swiftformat --lint ios
fi

if changed '^android/'; then
  run_check ./example/android/gradlew -p example/android ktlint
fi